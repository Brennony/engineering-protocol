import trig_helpers
from math import pi

def test_sin():
    assert trig_helpers.sine(0) == 0

def test_cos():
    assert trig_helpers.cosine(pi/2) == 1 

def test_tan():
    assert trig_helpers.tang(pi) == 0
    assert trig_helpers.tang(pi/2) is None

def test_asin():
    assert trig_helpers.arcsin(1) == pi/2
    assert trig_helpers.arccos(40) is None

def test_acos():
    assert trig_helpers.arccos(1) == 0
    assert trig_helpers.arccos(40) is None

def test_atan():
    assert trig_helpers.arctan(0) == 0

def test_csc():
    assert trig_helpers.csc(pi/2) == 0
    assert trig_helpers.csc(pi) is None

def test_sec():
    assert trig_helpers.sec(pi) == -1
    assert trig_helpers.sec(pi/2) is None

def test_cot():
    assert trig_helpers.cot(pi/2) == 0
    assert trig_helpers.cot(0) is None